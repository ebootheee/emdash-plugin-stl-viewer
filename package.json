{
	"name": "@bootheio/emdash-plugin-stl-viewer",
	"version": "0.1.0",
	"description": "EmDash CMS plugin: embed interactive 3D previews of STL files in Portable Text content",
	"keywords": [
		"emdash",
		"emdash-plugin",
		"astro",
		"stl",
		"3d",
		"three.js",
		"portable-text"
	],
	"author": "Eric Boothe",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ebootheee/emdash-plugin-stl-viewer.git"
	},
	"bugs": {
		"url": "https://github.com/ebootheee/emdash-plugin-stl-viewer/issues"
	},
	"homepage": "https://github.com/ebootheee/emdash-plugin-stl-viewer#readme",
	"type": "module",
	"main": "src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./astro": "./src/astro/index.ts",
		"./astro/StlViewer.astro": "./src/astro/StlViewer.astro"
	},
	"files": [
		"src",
		"scripts",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"generate-fixtures": "node scripts/generate-fixtures.mjs",
		"typecheck": "tsc --noEmit"
	},
	"peerDependencies": {
		"astro": ">=6.0.0",
		"emdash": ">=0.6.0",
		"three": "^0.171.0"
	},
	"devDependencies": {
		"@types/three": "^0.171.0",
		"typescript": "^5.6.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
